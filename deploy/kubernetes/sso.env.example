# Copy to .env.production at repository root; do not commit the real file.
# For kubectl --from-env-file: JSON values have NO surrounding shell quotes.
# Configure 1 to 3 enterprises; remove unused example objects.
SSO_PROVIDER=wecom
PUBLIC_URL=https://sso.example.com
FASTGPT_REDIRECT_URIS=["https://fastgpt.example.com/login/provider"]
AUTH_TOKEN=replace-with-a-strong-random-secret
WECOM_CORPS=[{"key":"corp-a","name":"企业 A","corpId":"ww_placeholder_a","agentId":"1000001","appSecret":"replace-app-secret-a"},{"key":"corp-b","name":"企业 B","corpId":"ww_placeholder_b","agentId":"1000001","appSecret":"replace-app-secret-b"},{"key":"corp-c","name":"企业 C","corpId":"ww_placeholder_c","agentId":"1000001","appSecret":"replace-app-secret-c"}]
