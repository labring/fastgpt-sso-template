# Copy to .env.local; Bun loads it automatically. Do not commit real credentials.
PORT=3000
SSO_PROVIDER=wecom
# Optional; defaults to SSO_PROVIDER. Only wecom is supported.
# SSO_SYNC_PROVIDER=wecom
# Public origin of THIS SSO service. HTTPS is required except on loopback.
PUBLIC_URL=https://sso.example.com
# Exact FastGPT callback allowlist, JSON array. No code/state query or fragment.
# Expired selection links return to the login page derived from the first entry.
FASTGPT_REDIRECT_URIS='["https://fastgpt.example.com/login/provider"]'
# Replace this placeholder with a strong random token; also configure it in FastGPT.
AUTH_TOKEN=replace-with-a-strong-random-secret
# Usernames use a shared wecom- prefix for original Pro repeat-sync compatibility.
# Configure 1 to 3 distinct enterprises; remove unused example objects. key is a permanent identity namespace.
# directorySecret is optional and defaults to appSecret. Use a self-built app
# with permission to read department names and member details, not an ID-only sync assistant.
WECOM_CORPS='[{"key":"corp-a","name":"企业 A","corpId":"ww_placeholder_a","agentId":"1000001","appSecret":"replace-app-secret-a"},{"key":"corp-b","name":"企业 B","corpId":"ww_placeholder_b","agentId":"1000001","appSecret":"replace-app-secret-b"},{"key":"corp-c","name":"企业 C","corpId":"ww_placeholder_c","agentId":"1000001","appSecret":"replace-app-secret-c"}]'
ww012a01dca8bc4483